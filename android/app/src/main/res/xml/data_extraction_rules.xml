<?xml version="1.0" encoding="utf-8"?>
<!-- FrameBeat keeps nothing on disk: the pattern lives in memory for the session. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
